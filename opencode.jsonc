{
  "$schema": "https://opencode.ai/config.json",
  // Мультиагентный пайплайн: оркестратор + специалисты.
  // Роли описаны в .opencode/agents/*.md, общий контракт — в AGENTS.md.
  // Правки инструкций и ролей разрешены только агенту build по явному указанию владельца.
  // Оркестратор и специалисты прав на запись в AGENTS.md, opencode.jsonc и .opencode/* не имеют.
  "default_agent": "orchestrator",
//  "model": "tokenharbor/deepseek-v4.1-flash",
  "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
  //"model": "agentrouter/gpt-5.6-sol",
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "AGENTS.md",
      "effect": "deny"
    },
    {
      "action": "write",
      "resource": "AGENTS.md",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "opencode.jsonc",
      "effect": "deny"
    },
    {
      "action": "write",
      "resource": "opencode.jsonc",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".opencode/*",
      "effect": "deny"
    },
    {
      "action": "write",
      "resource": ".opencode/*",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": {
      "permissions": [
        {
          "action": "edit",
          "resource": "AGENTS.md",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": "AGENTS.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "opencode.jsonc",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": "opencode.jsonc",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": ".opencode/*",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": ".opencode/*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "requirements-analyst": {
      //"model": "tokenharbor/deepseek-v4.1-flash"
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017"
      //"model": "agentrouter/gpt-5.6-sol"
    },
    "task-designer": {
      //"model": "tokenharbor/deepseek-v4.1-flash"
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017"
      //"model": "agentrouter/gpt-5.6-sol"
    },
    "test-designer": {
      //"model": "tokenharbor/deepseek-v4.1-flash"
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017"
      //"model": "agentrouter/gpt-5.6-sol"
    },
    "jira-publisher": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017"
    },
    "qase-publisher": {
      //"model": "opencode/deepseek-v4.1-flash-free"
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017"
    }
  }
}